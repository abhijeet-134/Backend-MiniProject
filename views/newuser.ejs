<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New User</title>
</head>
<body>
    <h3>Add New User:</h3>
    <form method="POST" action="/user/add">
        <input type="text" name="username" placeholder="Enter username">
    <br><br>
